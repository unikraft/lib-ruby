LIBRUBY_SRCS-y += $(LIBRUBY_SRC)/enc/encinit.c
else
ifneq ($(CONFIG_LIBRUBY_MINI),y)
# Init_enc() is also in miniinit.c
LIBRUBY_SRCS-y += $(LIBRUBY_SRC)/dmyenc.c
endif
endif

